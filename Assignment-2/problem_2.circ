        a  : in  STD_LOGIC;&#13;
        b  : in  STD_LOGIC;&#13;
        c  : in  STD_LOGIC;&#13;
        d  : in  STD_LOGIC;&#13;
        e  : in  STD_LOGIC;&#13;
