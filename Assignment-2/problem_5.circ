  <vhdl appearance="logisim_evolution" name="problem5">library IEEE;&#13;
use IEEE.STD_LOGIC_1164.ALL;&#13;
&#13;
entity problem5 is&#13;
    Port (&#13;
        vt  : in  STD_LOGIC_VECTOR(12 downto 0);&#13;
        en  : in  STD_LOGIC;&#13;
        seg : out STD_LOGIC_VECTOR(7 downto 0)&#13;
    );&#13;
end problem5;&#13;
&#13;
architecture Behavioral of problem5 is&#13;
begin&#13;
    process(vt, en)&#13;
        variable count_ones : integer range 0 to 13;&#13;
    begin&#13;
        count_ones := 0;&#13;
&#13;
        for i in 0 to 12 loop&#13;
            if vt(i) = '1' then&#13;
                count_ones := count_ones + 1;&#13;
            end if;&#13;
        end loop;&#13;
&#13;
        if en = '0' then&#13;
            seg &lt;= "00000000";&#13;
        else&#13;
            case count_ones is&#13;
                when 0  =&gt; seg &lt;= "11111100";&#13;
                when 1  =&gt; seg &lt;= "01100000";&#13;
                when 2  =&gt; seg &lt;= "11011010";&#13;
                when 3  =&gt; seg &lt;= "11110010";&#13;
                when 4  =&gt; seg &lt;= "01100110";&#13;
                when 5  =&gt; seg &lt;= "10110110";&#13;
                when 6  =&gt; seg &lt;= "10111110";&#13;
                when 7  =&gt; seg &lt;= "11100000";&#13;
                when 8  =&gt; seg &lt;= "11111110";&#13;
                when 9  =&gt; seg &lt;= "11110110";&#13;
                when 10 =&gt; seg &lt;= "11101110"; -- A&#13;
                when 11 =&gt; seg &lt;= "00111110"; -- b&#13;
                when 12 =&gt; seg &lt;= "10011100"; -- C&#13;
                when 13 =&gt; seg &lt;= "01111010"; -- d&#13;
                when others =&gt; seg &lt;= "00000000";&#13;
            end case;&#13;
        end if;&#13;
    end process;&#13;
end Behavioral;&#13;
</vhdl>
