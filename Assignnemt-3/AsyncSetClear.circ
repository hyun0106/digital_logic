  <vhdl appearance="logisim_evolution" name="Async_Set_Clear">
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity DFF_Async is
    Port (
        D   : in STD_LOGIC;
        clk : in STD_LOGIC;
        set : in STD_LOGIC;
        clr : in STD_LOGIC;
        Q   : out STD_LOGIC
    );
end DFF_Async;

architecture Behavioral of DFF_Async is
    signal q_internal : STD_LOGIC := '0';
begin

    process(clk, set, clr)
    begin
        if clr = '1' then
            q_internal &lt;= '0';
        elsif set = '1' then
            q_internal &lt;= '1';
        elsif rising_edge(clk) then
            q_internal &lt;= D;
        end if;
    end process;

    Q &lt;= q_internal;

end Behavioral;
</vhdl>
