  <vhdl appearance="logisim_evolution" name="D_Latch">&#13;
library IEEE;&#13;
use IEEE.STD_LOGIC_1164.ALL;&#13;
&#13;
entity D_Latch is&#13;
    Port (&#13;
        D  : in STD_LOGIC;&#13;
        en : in STD_LOGIC;&#13;
        Q  : out STD_LOGIC&#13;
    );&#13;
end D_Latch;&#13;
&#13;
architecture Behavioral of D_Latch is&#13;
    signal q_internal : STD_LOGIC := '0';&#13;
begin&#13;
&#13;
    process(D, en)&#13;
    begin&#13;
        if en = '1' then&#13;
            q_internal &lt;= D;&#13;
        end if;&#13;
    end process;&#13;
&#13;
    Q &lt;= q_internal;&#13;
&#13;
end Behavioral;&#13;
