  <vhdl appearance="logisim_evolution" name="JK_FlipFlop">
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity JK_FlipFlop is
    Port (
        J   : in STD_LOGIC;
        K   : in STD_LOGIC;
        clk : in STD_LOGIC;
        Q   : out STD_LOGIC
    );
end JK_FlipFlop;

architecture Behavioral of JK_FlipFlop is
    signal q_int : STD_LOGIC := '0';
begin

    process(clk)
    begin
        if rising_edge(clk) then
            if J = '0' and K = '0' then
                q_int &lt;= q_int;
            elsif J = '0' and K = '1' then
                q_int &lt;= '0';
            elsif J = '1' and K = '0' then
                q_int &lt;= '1';
            else
                q_int &lt;= not q_int;
            end if;
        end if;
    end process;

    Q &lt;= q_int;

end Behavioral;
</vhdl>
