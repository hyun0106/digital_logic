  <vhdl appearance="logisim_evolution" name="RS_Latch">&#13;
library IEEE;&#13;
use IEEE.STD_LOGIC_1164.ALL;&#13;
&#13;
entity RS_Latch is&#13;
    Port (&#13;
        S : in STD_LOGIC;&#13;
        R : in STD_LOGIC;&#13;
        Q : out STD_LOGIC;&#13;
        Qbar : out STD_LOGIC&#13;
    );&#13;
end RS_Latch;&#13;
&#13;
architecture Behavioral of RS_Latch is&#13;
    signal q_internal : STD_LOGIC := '0';&#13;
begin&#13;
&#13;
    process(S, R)&#13;
    begin&#13;
        if S = '1' and R = '0' then&#13;
            q_internal &lt;= '1';&#13;
        elsif S = '0' and R = '1' then&#13;
            q_internal &lt;= '0';&#13;
        elsif S = '0' and R = '0' then&#13;
            null;&#13;
        end if;&#13;
    end process;&#13;
&#13;
    Q &lt;= q_internal;&#13;
    Qbar &lt;= not q_internal;&#13;
&#13;
end Behavioral;&#13;
</vhdl>
